<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ═══ Main Content: Upper Area + Bottom 24h Bar ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Upper Area: Split Screen (Clock | Calendar Divider | Weather) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- ─── Left: Rectangular Seconds Cadre + Huge Bold Clock ─── -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="6dp">

                <!-- 60 Thick Rectangular Tick Marks encircling left half -->
                <com.hub.display.SecondsDialView
                    android:id="@+id/secondsDialView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Center Clock Text -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/timeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="135sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </FrameLayout>

            <!-- ─── Center: 8-Box Calendar Strip (Month/Day + 7 Days) ─── -->
            <com.hub.display.CalendarBarView
                android:id="@+id/calendarBarView"
                android:layout_width="52dp"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- ─── Right: Weather Particles + Animated Icon + Huge Temp ─── -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <!-- Dynamic Weather Particle Animation -->
                <com.hub.display.WeatherAnimationView
                    android:id="@+id/weatherAnimView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Weather Foreground Data -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Animated Weather Icon -->
                        <com.hub.display.AnimatedWeatherIconView
                            android:id="@+id/animatedWeatherIcon"
                            android:layout_width="110dp"
                            android:layout_height="110dp" />

                        <!-- Huge Temperature Matching Clock Size -->
                        <TextView
                            android:id="@+id/weatherTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="--°"
                            android:textColor="#FFFFFF"
                            android:textSize="135sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/weatherDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#CCCCCC"
                            android:textStyle="bold"
                            android:textSize="22sp" />

                        <!-- Main Current Rain Chance % -->
                        <TextView
                            android:id="@+id/currentRainProb"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="14dp"
                            android:text=""
                            android:textColor="#4FC3F7"
                            android:textStyle="bold"
                            android:textSize="20sp"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

        <!-- ─── Divider before Bottom Bar ─── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#1E1E1E" />

        <!-- ─── Bottom 24h Hourly Forecast Bar (Taller 86dp, Full Content Visible) ─── -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:background="#0A0A0A">

            <LinearLayout
                android:id="@+id/hourlyContainer"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>

    </LinearLayout>

    <!-- ═══ Burn-in Shield Overlay ═══ -->
    <com.hub.display.BurnInOverlay
        android:id="@+id/burnInOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- ═══ Settings Button ═══ -->
    <ImageButton
        android:id="@+id/settingsBtn"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        android:src="@drawable/ic_settings"
        android:alpha="0.4" />

</FrameLayout>
