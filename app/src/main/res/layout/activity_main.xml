<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- ═══ Main Full Screen Vertical Flow ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Upper Area: Split Screen (Clock | Slim Calendar Divider | Weather) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- ─── Left: Rectangular Cadre 60 Precision Blocks + Auto-fitting Clock ─── -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:padding="2dp">

                <!-- 60 Responsive Precision Blocks -->
                <com.hub.display.SecondsDialView
                    android:id="@+id/secondsDialView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Center Clock Text: Single line guaranteed with auto-sizing! -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/timeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="#FFFFFF"
                        android:textSize="82sp"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:ellipsize="none"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:includeFontPadding="false" />
                </LinearLayout>
            </FrameLayout>

            <!-- ─── Center: Slim Seamless Edge-to-Edge 8-Box Calendar Strip ─── -->
            <com.hub.display.CalendarBarView
                android:id="@+id/calendarBarView"
                android:layout_width="32dp"
                android:layout_height="match_parent"
                android:layout_marginStart="1dp"
                android:layout_marginEnd="1dp" />

            <!-- ─── Right: Weather Particles + Animated Icon + Auto-fitting Temp + Min/Max ─── -->
            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <!-- Dynamic Weather Particle Animation -->
                <com.hub.display.WeatherAnimationView
                    android:id="@+id/weatherAnimView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Weather Foreground Data -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="2dp">

                    <!-- Min & Max Temperature Tag right above temperature -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/weatherMinMax"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="▼ 9°   ▲ 16°"
                            android:textColor="#AAAAAA"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>

                    <!-- Main Icon + Temperature matching Clock height -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Custom Vector Animated Weather Icon -->
                        <com.hub.display.AnimatedWeatherIconView
                            android:id="@+id/animatedWeatherIcon"
                            android:layout_width="82dp"
                            android:layout_height="82dp" />

                        <!-- Temperature Matching Clock Single Line Size -->
                        <TextView
                            android:id="@+id/weatherTemp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="--°"
                            android:textColor="#FFFFFF"
                            android:textSize="82sp"
                            android:maxLines="1"
                            android:singleLine="true"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:includeFontPadding="false" />
                    </LinearLayout>

                    <!-- Condition Description + 10-Droplets Rain Scale -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/weatherDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="#CCCCCC"
                            android:textStyle="bold"
                            android:textSize="17sp" />

                        <!-- 10 Droplets Scale for Rain % -->
                        <LinearLayout
                            android:id="@+id/rainDropletsContainer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <com.hub.display.RainChanceDropletsView
                                android:id="@+id/rainDropletsView"
                                android:layout_width="75dp"
                                android:layout_height="16dp" />

                            <TextView
                                android:id="@+id/currentRainProbText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="30%"
                                android:textColor="#29B6F6"
                                android:textStyle="bold"
                                android:textSize="13sp" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

        <!-- ─── Sleek Hairline Divider ─── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#161616" />

        <!-- ─── Dynamic Bottom Bar (Alternates every 1 min: 24h Hourly <-> Live News Ticker) ─── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#070707">

            <!-- View 1: 24h Hourly Forecast -->
            <HorizontalScrollView
                android:id="@+id/hourlyScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/hourlyContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp" />
            </HorizontalScrollView>

            <!-- View 2: Live Marquee News Ticker Bar (Feels like, Wind, Humidity, UV...) -->
            <HorizontalScrollView
                android:id="@+id/tickerScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scrollbars="none"
                android:visibility="gone">

                <TextView
                    android:id="@+id/newsTickerText"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:text="FEELS LIKE: --°   •   WIND: -- km/h   •   HUMIDITY: --%   •   UV INDEX: --   •   RAIN CHANCE: --%" />
            </HorizontalScrollView>

        </FrameLayout>

    </LinearLayout>

    <!-- ═══ Burn-in Shield Overlay ═══ -->
    <com.hub.display.BurnInOverlay
        android:id="@+id/burnInOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <!-- ═══ Settings Button ═══ -->
    <ImageButton
        android:id="@+id/settingsBtn"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        android:src="@drawable/ic_settings"
        android:alpha="0.35" />

</FrameLayout>
